<Window x:Class="Berichthefte_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="Berichtsheft"
        Height="900"
        Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <!-- Dashboard Stat Card Style -->
        <Style x:Key="DashboardStatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="DashboardProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="DashboardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DashboardValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="DashboardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,12,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBoxForeground}"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Theme Toggle Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,0">
            <TextBlock Text="🌙" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="16"/>
            
            <!-- Custom Toggle Switch -->
            <ToggleButton x:Name="ThemeToggleButton" 
                         Width="60" Height="28" 
                         Click="ThemeToggleButton_Click"
                         Background="Transparent"
                         Foreground="White"
                         ToolTip="Toggle Dark/Light Mode"
                         Padding="0">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <!-- Background Track -->
                            <Border Background="#E0E0E0"
                                    CornerRadius="14"
                                    BorderThickness="2"
                                    BorderBrush="#D0D0D0"/>
                            
                            <!-- Animated Circle -->
                            <Border x:Name="SwitchCircle" 
                                   Width="24" Height="24"
                                   Background="White"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                        </Grid>
                        
                        <!-- Triggers for Animation -->
                        <ControlTemplate.Triggers>
                            <!-- Unchecked = Light Mode (Circle on Left) -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="SwitchCircle" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="SwitchCircle" Property="Margin" Value="2,0,0,0"/>
                            </Trigger>
                            
                            <!-- Checked = Dark Mode (Circle on Right) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchCircle" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchCircle" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchCircle" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            
            <TextBlock Text="☀️" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="16"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">

                <!-- ================= ANIMATED DASHBOARD ================= -->
                <Border Margin="0,0,0,24" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Welcome Back! 👋" Style="{StaticResource DashboardTitleStyle}"/>
                        <TextBlock Text="Hier ist dein Fortschritt für diese Woche" Foreground="#6B7280" Margin="0,0,0,20" FontSize="14"/>

                        <!-- Stats Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Stat Card 1: Betriebliche Stunden -->
                            <Border Style="{StaticResource DashboardStatCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DashboardLabelStyle}" Text="💼 Betriebliche Stunden"/>
                                    <TextBlock x:Name="BetrieblicheStundenValue" Style="{StaticResource DashboardValueStyle}" Text="0"/>
                                    <TextBlock Text="/ 40h" Foreground="#9CA3AF" FontSize="13" Margin="0,2,0,0"/>
                                    <ProgressBar Style="{StaticResource DashboardProgressBarStyle}" x:Name="BetrieblicheProgress" Value="0" Maximum="100"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat Card 2: Schulische Stunden -->
                            <Border Grid.Column="1" Style="{StaticResource DashboardStatCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DashboardLabelStyle}" Text="🎓 Schulische Stunden"/>
                                    <TextBlock x:Name="SchulischeStundenValue" Style="{StaticResource DashboardValueStyle}" Text="0"/>
                                    <TextBlock Text="/ 40h" Foreground="#9CA3AF" FontSize="13" Margin="0,2,0,0"/>
                                    <ProgressBar Style="{StaticResource DashboardProgressBarStyle}" x:Name="SchulischeProgress" Value="0" Maximum="100"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat Card 3: Aktivitäten -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardStatCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DashboardLabelStyle}" Text="✅ Aktivitäten"/>
                                    <TextBlock x:Name="AnzahlAktivitätenValue" Style="{StaticResource DashboardValueStyle}" Text="0"/>
                                    <TextBlock Text="diese Woche" Foreground="#9CA3AF" FontSize="13" Margin="0,2,0,0"/>
                                    <Border Height="6" Margin="0,8,0,0" Background="#10B981" CornerRadius="3"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat Card 4: Gesamtstunden -->
                            <Border Grid.Column="3" Style="{StaticResource DashboardStatCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DashboardLabelStyle}" Text="⏱️ Gesamtstunden"/>
                                    <TextBlock x:Name="GesamtStundenValue" Style="{StaticResource DashboardValueStyle}" Text="0"/>
                                    <TextBlock Text="/ 80h" Foreground="#9CA3AF" FontSize="13" Margin="0,2,0,0"/>
                                    <ProgressBar Style="{StaticResource DashboardProgressBarStyle}" x:Name="GesamtProgress" Value="0" Maximum="100"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= TRAINEE ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Trainee Info" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Firma:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Firma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Abteilung:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Abteilung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Ausbildungsjahr:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Ausbildungsjahr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= Zeitraum ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Zeitraum" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Ausbildungsnachweis Nr.:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding CurrentBerichtsheft.Zeitraum.AusbildungsnachweisNr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Woche:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CurrentBerichtsheft.Zeitraum.KalenderWoche, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Von:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Grid.Row="2" Grid.Column="1"
                                        SelectedDate="{Binding CurrentBerichtsheft.Zeitraum.Von, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Bis:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Grid.Row="3" Grid.Column="1"
                                        SelectedDate="{Binding CurrentBerichtsheft.Zeitraum.Bis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= BETRIEB ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Betriebliche Tätigkeiten" Style="{StaticResource SectionTitleStyle}"/>

                        <ListBox ItemsSource="{Binding CurrentBerichtsheft.Betrieb}" Height="150" x:Name="ActivitiesListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Aktivitaet}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stunden}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Typ}" VerticalAlignment="Center"/>

                                        <Button Grid.Column="3"
                                                Content="×"
                                                Click="DeleteActivityButton_Click"
                                                DataContext="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="TotalBetrieblichHoursTextBlock"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,6,0,12"/>

                        <!-- Column Headers for Input Fields -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Beschreibung" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#666"/>
                            <TextBlock Grid.Column="1" Text="Stunden" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#666"/>
                            <TextBlock Grid.Column="2" Text="Typ" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#666"/>
                        </Grid>

                        <!-- Input Fields -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="NewActivityName" Margin="0,4,8,4"/>
                            <TextBox Grid.Column="1" x:Name="NewActivityHours" Margin="0,4,8,4"/>
                            <ComboBox Grid.Column="2" x:Name="NewActivityType" SelectedIndex="0" Margin="0,4,8,4">
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Urlaub"/>
                                <ComboBoxItem Content="Krank"/>
                            </ComboBox>

                            <Button Grid.Column="3"
                                    Content="Add"
                                    Click="AddActivityButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,4,0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= BESCHREIBUNG ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Beschreibung eines Arbeitsvorgangs"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBox Text="{Binding CurrentBerichtsheft.Beschreibung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="170"/>
                    </StackPanel>
                </Border>

                <!-- ================= SCHULE ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Schulaktivitäten" Style="{StaticResource SectionTitleStyle}"/>

                        <ListBox ItemsSource="{Binding CurrentBerichtsheft.Schule}" Height="150" x:Name="SchoolListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Fach}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Beschreibung}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="2"
                                                Content="×"
                                                Click="DeleteSchoolActivityButton_Click"
                                                DataContext="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Column Headers for Input Fields -->
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Fach" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#666"/>
                            <TextBlock Grid.Column="1" Text="Beschreibung" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#666"/>
                        </Grid>

                        <!-- Input Fields -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="NewSchoolFach" Margin="0,4,8,4"/>
                            <TextBox Grid.Column="1" x:Name="NewSchoolBeschreibung" Margin="0,4,0,4"/>
                        </Grid>

                        <Button Content="Add Schulaktivität"
                                Click="AddSchoolActivityButton_Click"
                                Width="170"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ================= HOURS ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Stundenübersicht" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Schule Gesamtstunden:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="SchoolTotalHoursTextBox"
                                     Text="{Binding CurrentBerichtsheft.TotalSchulStunden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="SchoolTotalHoursTextBox_TextChanged"/>
                        </Grid>

                        <TextBlock x:Name="TotalHoursTextBlock"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ================= ACTIONS ================= -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,16">
                    <Button Content="Clear All"
                            Click="ClearAllButton_Click"
                            Width="120"
                            Height="38"
                            Background="#DC3545"
                            Foreground="White"
                            FontFamily="Segoe UI Semibold"
                            FontSize="13"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>

                    <Button Content="Als PDF exportieren"
                            Command="{Binding ExportPdfCommand}"
                            Width="170"
                            Height="38"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Save"
                            Width="110"
                            Height="38"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>