<Window x:Class="Berichthefte_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Berichtsheft" Height="829" Width="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- ================= TRAINEE ================= -->
            <TextBlock Text="Trainee Info" FontWeight="Bold" FontSize="14"/>

            <Grid Margin="0,5,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name:"/>
                <TextBox Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Name}"/>

                <TextBlock Grid.Row="1" Text="Firma:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Firma}"/>

                <TextBlock Grid.Row="2" Text="Abteilung:"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Abteilung}"/>

                <TextBlock Grid.Row="3" Text="Ausbildungsjahr:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentBerichtsheft.Trainee.Ausbildungsjahr}"/>
            </Grid>

            <!-- ================= BETRIEB ================= -->
            <TextBlock Text="Betriebliche Tätigkeiten" FontWeight="Bold" FontSize="14"/>

            <ListBox ItemsSource="{Binding CurrentBerichtsheft.Betrieb}" Height="120" x:Name="ActivitiesListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Aktivitaet}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stunden}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Typ}"/>

                            <Button Grid.Column="3" Content="X"
                                    Click="DeleteActivityButton_Click"
                                    DataContext="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TotalBetrieblichHoursTextBlock"
                       FontWeight="Bold" Margin="0,5,0,5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewActivityName"/>
                <TextBox Grid.Column="1" x:Name="NewActivityHours"/>
                <ComboBox Grid.Column="2" x:Name="NewActivityType" SelectedIndex="0">
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="Urlaub"/>
                    <ComboBoxItem Content="Krank"/>
                </ComboBox>
                <Button Grid.Column="3" Content="Add"
                        Click="AddActivityButton_Click"/>
            </Grid>

            <!-- ================= BESCHREIBUNG ================= -->
            <TextBlock Text="Beschreibung eines Arbeitsvorgangs"
           FontWeight="Bold"
           FontSize="14"
           Margin="0,10,0,5"/>

            <TextBox Text="{Binding CurrentBerichtsheft.Beschreibung,
                       UpdateSourceTrigger=PropertyChanged}"
         AcceptsReturn="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         Height="150"
         Margin="0,0,0,10"/>

            <!-- ================= SCHULE ================= -->
            <TextBlock Text="Schulaktivitäten" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>

            <ListBox ItemsSource="{Binding CurrentBerichtsheft.Schule}" Height="120" x:Name="SchoolListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Fach}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Beschreibung}" TextWrapping="Wrap"/>

                            <Button Grid.Column="2" Content="X"
                                    Click="DeleteSchoolActivityButton_Click"
                                    DataContext="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewSchoolFach"/>
                <TextBox Grid.Column="1" x:Name="NewSchoolBeschreibung"/>
            </Grid>

            <Button Content="Add Schulaktivität"
                    Click="AddSchoolActivityButton_Click"/>

            <!-- ================= HOURS ================= -->
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Schule Gesamtstunden:" FontWeight="Bold"/>
                <TextBox Grid.Column="1"
                         x:Name="SchoolTotalHoursTextBox"
                         TextChanged="SchoolTotalHoursTextBox_TextChanged"/>
            </Grid>

            <TextBlock x:Name="TotalHoursTextBlock"
                       FontWeight="Bold" Margin="0,10"/>

            <Button Content="Save" Width="100"
                    HorizontalAlignment="Right"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
